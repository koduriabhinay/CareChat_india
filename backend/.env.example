# --- Required -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Long random strings. Make each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CARECHAT_SECRET_KEY=
CARECHAT_CRON_TOKEN=
# Encrypts health data at rest. Make with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe: losing it makes saved data unreadable.
CARECHAT_ENCRYPTION_KEY=

# --- Sign-in ----------------------------------------------------------------
# "dev" adds a no-password sign-in and shows email codes on screen. Never use it live.
CARECHAT_AUTH_MODE=dev
CARECHAT_ADMIN_EMAILS=you@example.com
# From Google Cloud console > APIs & Services > Credentials (OAuth client, Web). Optional.
CARECHAT_GOOGLE_CLIENT_ID=

# --- Email (sign-in codes and reminders) -------------------------------------
# "console" prints emails to the server log; "smtp" sends them.
CARECHAT_MAIL=console
# Zoho Mail SMTP, for example: smtp.zoho.in, 587, your address and an app password
CARECHAT_SMTP_HOST=
CARECHAT_SMTP_PORT=587
CARECHAT_SMTP_USER=
CARECHAT_SMTP_PASSWORD=
CARECHAT_MAIL_FROM=CareChat <no-reply@example.com>
CARECHAT_APP_URL=http://localhost:3000
CARECHAT_ALLOWED_ORIGINS=http://localhost:3000

# --- Storage ------------------------------------------------------------------
# "sqlite" on your computer, "catalyst" on Zoho Catalyst (Data Store table "records")
CARECHAT_STORE=sqlite
CARECHAT_DB_PATH=carechat.db
CARECHAT_KNOWLEDGE_PATH=knowledge.db

# --- Cost limits -------------------------------------------------------------
# New reports and questions stop when this month's Claude spend reaches the budget.
CARECHAT_MONTHLY_BUDGET_USD=25
CARECHAT_DAILY_REPORTS=10
CARECHAT_DAILY_QUESTIONS=60

# --- Optional -------------------------------------------------------------------
# CARECHAT_ANSWER_MODEL=claude-sonnet-5-5
# CARECHAT_SAFETY_MODEL=claude-haiku-5-5
# CARECHAT_REGION=IN            # IN (112, Tele-MANAS) or US (911, 988)
# CARECHAT_USE_FALLBACKS=true
